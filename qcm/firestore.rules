rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Les QCM : accès totalement libre en lecture ET en écriture.
    // Il n'y a pas de connexion sur ce site (par choix), donc pas
    // moyen de distinguer "toi" de n'importe quel visiteur : toute
    // personne qui connaît l'adresse admin.html peut créer, modifier
    // ou supprimer un QCM. Ne partage donc pas ce lien publiquement.
    match /qcm_quizzes/{quizId} {
      allow read: if true;
      allow write: if true;
    }

    // Les résultats : tout le monde peut en créer (un élève envoie
    // son résultat sans compte), et tout le monde peut les lire
    // (nécessaire pour la page stats). En revanche, un résultat ne
    // peut jamais être modifié ou supprimé une fois envoyé, pour
    // éviter que quelqu'un trafique une note déjà enregistrée.
    match /qcm_resultats/{resultId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }
  }
}
